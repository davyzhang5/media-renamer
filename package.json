{
  "name": "media-renamer",
  "version": "0.5.0",
  "description": "A local-first, configurable media renamer powered by a local vision model.",
  "main": "electron/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.js",
    "smoke:model": "node scripts/smoke-test-model.js",
    "pack:mac": "electron-builder --mac --dir",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.local.mediarenamer",
    "productName": "Media Renamer",
    "asar": true,
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Media-Renamer-${version}-${arch}-setup.${ext}",
      "extraResources": [
        {
          "from": "vendor/ffmpeg",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg.exe",
            "ffprobe.exe",
            "LICENSE.txt"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Media Renamer"
    }
  }
}
